def translate_ctg(sentence):
    model.eval()
    inputs = "translate dialect to bangla: " + sentence

    enc = tokenizer(
        inputs,
        return_tensors="pt",
        truncation=True,
        max_length=128
    ).to("cuda")

    with torch.no_grad():
        gen = model.generate(
            **enc,
            max_length=128,
            num_beams=5,
            length_penalty=1.0
        )

    output = tokenizer.decode(gen[0], skip_special_tokens=True)
    return output
